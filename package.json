{
  "name": "dbus-sdk",
  "version": "2.0.0",
  "description": "A Node.js SDK for interacting with DBus, enabling seamless service calling and exposure with TypeScript support",
  "main": "build/NodeDBusSDK.js",
  "types": "build/NodeDBusSDK.d.ts",
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts",
    "!build/tests/**",
    "doc/",
    "examples/*.ts",
    "examples/README.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "shx rm -rf ./build",
    "build": "tsc",
    "rebuild": "npm run clean && npm run build",
    "release": "release-it",
    "postrelease": "npm publish",
    "prepublishOnly": "npm run rebuild",
    "test": "npm run rebuild && node --test --test-timeout=120000 \"build/tests/unit/**/*.test.js\" \"build/tests/integration/**/*.test.js\"",
    "test:unit": "npm run rebuild && node --test --test-timeout=120000 \"build/tests/unit/**/*.test.js\"",
    "test:integration": "npm run rebuild && node --test --test-timeout=120000 \"build/tests/integration/**/*.test.js\"",
    "test:perf": "npm run rebuild && node --test --test-concurrency=1 \"build/tests/perf/**/*.test.js\"",
    "example": "node --import ./examples/use-local-build.mjs",
    "docs:api": "npm run build && node ./build/tests/tools/ApiDoc.js",
    "bench": "npm run rebuild && node --expose-gc ./build/tests/benchmark/run.js",
    "bench:compare": "node ./build/tests/benchmark/compare.js",
    "bench:ab": "npm run rebuild && node ./build/tests/benchmark/ab.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myq1991/node-dbus-sdk.git"
  },
  "keywords": [
    "dbus",
    "node",
    "nodejs",
    "ipc",
    "typescript",
    "sdk",
    "linux",
    "dbus-service",
    "interprocess-communication"
  ],
  "author": "alex.ma",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/myq1991/node-dbus-sdk/issues"
  },
  "homepage": "https://github.com/myq1991/node-dbus-sdk#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^8.56.0",
    "json5": "^2.2.3",
    "reflect-metadata": "^0.2.2",
    "release-it": "^19.0.2",
    "shx": "^0.4.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "xml2js": "^0.6.2"
  }
}
